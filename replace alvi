			end
		else
			addOld(obj); n = 1
		end
		toast(n .. " objek ditambahkan", C.OK)
		setPick(nil)
	end
end))

-- ================= REPLACE / UNDO =================
local function doReplace(keep)
	if busy then return end
	if not newObj or not newObj.Parent then toast("Pilih objek baru dulu!", C.BAD); return end
	local list = {}
	for _, o in ipairs(oldList) do
		if o.Parent and o ~= newObj then table.insert(list, o) end
	end
	if #list == 0 then toast("Pilih objek lama dulu!", C.BAD); return end
	busy = true; setPick(nil)
	toast("Memproses " .. #list .. " objek...", C.WARN)
	task.spawn(function()
		local ok, fail, rec = 0, 0, {}
		for i, old in ipairs(list) do
			local c
			local success = pcall(function()
				local center, rot, parent = getAABBCenter(old), getRotation(old), old.Parent
				c = newObj:Clone()
				c.Parent = parent
				if scaleMode == 1 then uniformScale(c, old) end
				if rotMode == 1 then applyRotation(c, rot) end
				moveToPosition(c, center)
				if keep then
					table.insert(rec, {old = old, parent = parent, new = c})
					old.Parent = nil
				else
					old:Destroy()
				end
			end)
			if success then ok = ok + 1 else fail = fail + 1; if c then c:Destroy() end end
			if i % 10 == 0 then RunService.Heartbeat:Wait() end
		end
		if keep and #rec > 0 then
			table.insert(undoStack, rec)
			if #undoStack > 5 then table.remove(undoStack, 1) end
		end
		clearOld()
		busy = false
		if fail == 0 then toast("Berhasil mengganti " .. ok .. " obstacle!", C.OK)
		else toast(ok .. " berhasil, " .. fail .. " gagal", C.WARN) end
	end)
end

local function doUndo()
	local rec = table.remove(undoStack)
	if not rec then toast("Tidak ada yang bisa di-undo", C.WARN); return end
	local n = 0
	for _, r in ipairs(rec) do
		pcall(function()
			if r.new and r.new.Parent then r.new:Destroy() end
			r.old.Parent = r.parent
			n = n + 1
		end)
	end
	toast("Undo: " .. n .. " objek dikembalikan", C.OK)
end

