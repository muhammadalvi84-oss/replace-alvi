-- ================= GEOMETRI =================
local function corners(obj, fn)
	for _, v in ipairs(obj:GetDescendants()) do
		if v:IsA("BasePart") then
			local cf, h = v.CFrame, v.Size * .5
			for _, sx in ipairs({-1,1}) do for _, sy in ipairs({-1,1}) do for _, sz in ipairs({-1,1}) do
				fn(cf:PointToWorldSpace(Vector3.new(sx*h.X, sy*h.Y, sz*h.Z)))
			end end end
		end
	end
end
local function getAABBCenter(obj)
	if obj:IsA("BasePart") then return obj.Position end
	local INF = math.huge
	local mn, mx = Vector3.new(INF,INF,INF), Vector3.new(-INF,-INF,-INF)
	corners(obj, function(p) mn = Vector3.new(math.min(mn.X,p.X), math.min(mn.Y,p.Y), math.min(mn.Z,p.Z))
		mx = Vector3.new(math.max(mx.X,p.X), math.max(mx.Y,p.Y), math.max(mx.Z,p.Z)) end)
	return (mn + mx) * .5
end
local function getSize(obj)
	if obj:IsA("BasePart") then return obj.Size end
	local ok, s = pcall(function() return obj:GetExtentsSize() end)
	if ok and s then return s end
	local INF = math.huge
	local mn, mx = Vector3.new(INF,INF,INF), Vector3.new(-INF,-INF,-INF)
	corners(obj, function(p) mn = Vector3.new(math.min(mn.X,p.X), math.min(mn.Y,p.Y), math.min(mn.Z,p.Z))
		mx = Vector3.new(math.max(mx.X,p.X), math.max(mx.Y,p.Y), math.max(mx.Z,p.Z)) end)
	return mx - mn
end
local function getRotation(obj)
	local cf
	if obj:IsA("BasePart") then cf = obj.CFrame
	else
		local ok, p = pcall(function() return obj:GetPivot() end)
		cf = ok and p or CFrame.new()
	end
	return cf - cf.Position
end
-- skala SERAGAM (satu faktor) -> bentuk tidak melar
local function uniformScale(newO, oldO)
	local o, n = getSize(oldO), getSize(newO)
	local oMax, nMax = math.max(o.X, o.Y, o.Z), math.max(n.X, n.Y, n.Z)
	if nMax < .001 or oMax < .001 then return end
	local f = oMax / nMax
	if newO:IsA("Model") then
		pcall(function() newO:ScaleTo(newO:GetScale() * f) end)
	elseif newO:IsA("BasePart") then
		newO.Size = newO.Size * f
	end
end
local function applyRotation(newO, rot)
	if newO:IsA("Model") then
		newO:PivotTo(CFrame.new(newO:GetPivot().Position) * rot)
	elseif newO:IsA("BasePart") then
		newO.CFrame = CFrame.new(newO.Position) * rot
	end
end
local function moveToPosition(newO, target)
	local shift = target - getAABBCenter(newO)
	if newO:IsA("Model") then
		local pv = newO:GetPivot()
		newO:PivotTo(CFrame.new(pv.Position + shift) * (pv - pv.Position))
	elseif newO:IsA("BasePart") then
		newO.Position = newO.Position + shift
	end
end

